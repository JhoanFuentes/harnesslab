# No automatic .env loading. study-run --env-file .env reads ONLY the key;
# its model/settings/prices come from the frozen plan. Other commands use env.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional, provide BOTH rates from the pricing applicable to your chosen model.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Optional cache-read rate. Omit to charge all input at the full input rate.
OPENAI_CACHED_INPUT_USD_PER_MILLION=
